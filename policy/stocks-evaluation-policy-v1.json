{
  "schema": "stocks-evaluation-policy/1",
  "policy_version": "1.0.0",
  "status": "PROPOSED_PENDING_OWNER_APPROVAL",
  "created_at": "2026-09-24",
  "scope": "Decisão estatística do protocolo v2 (stocks_predictor/v2). Não habilita capital nem certifica lucro. Limiares propostos no Prompt 3b antes de qualquer avaliação em dado real; valem só depois de aprovados pelo dono.",
  "data": {
    "forbid_synthetic_dataset": true,
    "min_sessions": 504
  },
  "risk_free": {
    "allowed_series": ["BCB-SGS-11", "BCB-SGS-12", "BCB-SGS-1178", "BCB-SGS-4389"]
  },
  "baselines": {
    "required": ["ew_universe", "index_buy_and_hold"],
    "metric": "sharpe_excess_ann",
    "rule": "strictly_greater_than_each"
  },
  "psr": {
    "benchmark_sharpe_per_period": 0.0,
    "min_probability": 0.95
  },
  "dsr": {
    "min_probability": 0.95,
    "n_prior_lower_bound": 71,
    "n_prior_source": "docs/evidence/2026-09-24-prompt2-auditoria.md, seção 5 (LOWER_BOUND)",
    "n_multipliers": [1, 2, 5],
    "n_upper": 150,
    "aggregation": "worst_case"
  },
  "pbo": {
    "max": 0.2,
    "n_splits": 16
  },
  "t_stat": {
    "threshold": 3.0,
    "role": "diagnostic",
    "reference": "Harvey, Liu & Zhu (2016), Review of Financial Studies 29(1)"
  },
  "cpcv": {
    "n_groups": 6,
    "k_test": 2,
    "z": 1.96,
    "max_lag": 12
  }
}
